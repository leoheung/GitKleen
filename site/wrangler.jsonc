// Deploys the site to your own domain: npx wrangler deploy, from here.
// Set the route below first, or leave it out to deploy to workers.dev.
{
  "name": "gitkleen-site",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // "routes": [{ "pattern": "example.com/gitkleen*", "zone_name": "example.com" }]
}
